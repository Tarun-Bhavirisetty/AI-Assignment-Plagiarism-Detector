# MetaGuard Environment Configuration Example
# Backend Configuration

DATABASE_URL=sqlite:///./metaguard.db# JWT Authentication
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_UPLOAD_SIZE_MB=50

# Gmail SMTP Configuration for Verification (Optional in development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
ALLOW_DEV_VERIFICATION_LINK=true
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Online Source Discovery Configuration (Optional - free tier at https://tavily.com)
# Free plan includes 1,000 search API credits/month with no credit card required.
# Leave blank to disable external online search gracefully without affecting internal similarity.
TAVILY_API_KEY=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
SOURCE_DISCOVERY_MAX_QUERIES=5
SOURCE_DISCOVERY_MAX_RESULTS=5
